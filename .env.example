# Rain API base URL (optional; defaults to https://rain-api.vercel.app)
VITE_RAIN_API_URL=https://rain-api.vercel.app

# Retired. The client does not read VITE_VISUALCROSSING_KEY. Do not set it.
# The server-only key is VISUALCROSSING_API_KEY below (Vercel). Local weather
# needs `vercel dev` or VITE_WEATHER_PROXY_URL pointing at a deployed proxy.
# VITE_VISUALCROSSING_KEY=

# Weather proxy origin. Required for Capacitor/native builds (HTTPS, no /api/weather-proxy suffix).
# Web production can leave this empty and use the same-origin /api/weather-proxy path.
VITE_WEATHER_PROXY_URL=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Weather proxy server variables (configure in Vercel; never use VITE_ prefixes)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VISUALCROSSING_API_KEY=
# Comma-separated exact browser/native origins, e.g. https://acreledger.example,capacitor://localhost
ALLOWED_ORIGINS=
# Global daily spend caps for weather-proxy and Ask the Book (UTC calendar day).
# Handlers fail closed with HTTP 503 when the cap is exceeded. Owner-only Vercel env.
WEATHER_DAILY_CAP=2000
AI_DAILY_CAP=500

# AI assistant (Ask the book) — server-only. Never prefix OPENROUTER_API_KEY with VITE_.
OPENROUTER_API_KEY=
# Optional OpenRouter primary model (default minimax/minimax-m3:free; falls back to openrouter/free)
AI_MODEL=
# Native/Capacitor origin for the deployed Vercel function (append /api/ai-assistant automatically)
VITE_AI_ASSISTANT_URL=

# Billing — Stripe test or live (Ticket D). Server-only (Vercel functions).
# Absent or "false": test mode, sk_test_ keys only. "true": live mode, sk_live_ keys only.
# Any other value, a live key without the flag, or a test key with the flag is refused.
BILLING_LIVE_CHARGES=false
# Stripe secret key. Test mode requires sk_test_...; live mode (flag true) requires sk_live_...
STRIPE_SECRET_KEY=
# Stripe yearly price for the locked $299/year Pro plan (price_...). There is no trial; checkout charges right away.
STRIPE_PRICE_ID=
# Stripe webhook signing secret (whsec_...) for api/stripe-webhook.ts. In live mode use the live endpoint's secret.
STRIPE_WEBHOOK_SECRET=
# Service role key for webhook entitlement writes (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=
# Internal rollout allowlist, comma-separated emails or user IDs. Server-only.
# Required in Vercel production (build fails if unset); optional with a warning elsewhere.
# Test mode: empty = billing coming soon for everyone. Live mode: checkout is open to every
# authenticated web owner without blanking this list. Never expose this as a VITE_* variable.
BILLING_ALLOWLIST=

# Billing UI flag (client). UI stays hidden unless VITE_BILLING_UI_ENABLED is exactly "true".
# Allowlist checks go through GET /api/billing-eligibility; VITE_BILLING_ALLOWLIST is unused.
VITE_BILLING_UI_ENABLED=
# iOS app only: https URL of the website page that explains/sells the Pro plan. The iOS app shows a
# link to it ONLY on the US App Store storefront (see docs/ios-storefront-link.md). Empty = no link.
VITE_UPGRADE_URL=

# Australia pilot region card (client). Hidden unless VITE_AU_PILOT_ENABLED is exactly "true"
# or the signed-in email (case-insensitive) or user id (exact) is in the comma-separated
# VITE_AU_PILOT_ALLOWLIST. Not a secret.
VITE_AU_PILOT_ENABLED=
VITE_AU_PILOT_ALLOWLIST=

# Live auth integration test only (store real values in .env.test.local)
TEST_BOT_EMAIL=
TEST_BOT_PASSWORD=

# Optional client crash reporting. Leave unset. No Sentry project is required.
# Empty: ErrorBoundary, window.onerror, and unhandledrejection stay console-only.
# Public browser endpoint: HTTPS only, no credentials/query/fragment; collector must rate-limit.
VITE_ERROR_REPORTING_DSN=
