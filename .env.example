# Rain API base URL (optional; defaults to https://rain-api.vercel.app)
VITE_RAIN_API_URL=https://rain-api.vercel.app

# Visual Crossing API key — local `npm run dev` only.
# Never set this for App Store, Capacitor, or any other native/production build.
VITE_VISUALCROSSING_KEY=

# Weather proxy origin. Required for Capacitor/native builds (HTTPS, no /api/weather-proxy suffix).
# Web production can leave this empty and use the same-origin /api/weather-proxy path.
VITE_WEATHER_PROXY_URL=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Weather proxy server variables (configure in Vercel; never use VITE_ prefixes)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VISUALCROSSING_API_KEY=
# Comma-separated exact browser/native origins, e.g. https://acreledger.example,capacitor://localhost
ALLOWED_ORIGINS=
# Global daily spend caps for weather-proxy and Ask the Book (UTC calendar day).
# Handlers fail closed with HTTP 503 when the cap is exceeded. Owner-only Vercel env.
WEATHER_DAILY_CAP=2000
AI_DAILY_CAP=500

# AI assistant (Ask the book) — server-only. Never prefix OPENROUTER_API_KEY with VITE_.
OPENROUTER_API_KEY=
# Optional OpenRouter primary model (default minimax/minimax-m3:free; falls back to openrouter/free)
AI_MODEL=
# Native/Capacitor origin for the deployed Vercel function (append /api/ai-assistant automatically)
VITE_AI_ASSISTANT_URL=

# Billing — Stripe TEST MODE only (Ticket D). No live keys anywhere until legal approval.
# Server-only (Vercel functions). Must stay false; endpoints refuse anything else.
BILLING_LIVE_CHARGES=false
# Stripe test secret key (sk_test_...). Live keys (sk_live_...) are rejected by the endpoints.
STRIPE_SECRET_KEY=
# Stripe TEST price for the locked $299/year plan (price_...), trial configured server-side (122 days).
STRIPE_PRICE_ID=
# Stripe test webhook signing secret (whsec_...) for api/stripe-webhook.ts.
STRIPE_WEBHOOK_SECRET=
# Service role key for webhook entitlement writes (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=
# Internal rollout allowlist, comma-separated emails or user IDs. Empty = billing coming soon for everyone.
BILLING_ALLOWLIST=

# Billing UI flags (client). UI stays hidden unless VITE_BILLING_UI_ENABLED is exactly "true".
# Mirror of BILLING_ALLOWLIST for the client; not a secret.
VITE_BILLING_UI_ENABLED=
VITE_BILLING_ALLOWLIST=

# Australia pilot region card (client). Hidden unless VITE_AU_PILOT_ENABLED is exactly "true"
# or the signed-in email is in the comma-separated VITE_AU_PILOT_ALLOWLIST. Not a secret.
VITE_AU_PILOT_ENABLED=
VITE_AU_PILOT_ALLOWLIST=

# Live auth integration test only (store real values in .env.test.local)
TEST_BOT_EMAIL=
TEST_BOT_PASSWORD=

# Optional client crash reporting. Leave unset. No Sentry project is required.
# Empty: ErrorBoundary, window.onerror, and unhandledrejection stay console-only.
# Public browser endpoint: HTTPS only, no credentials/query/fragment; collector must rate-limit.
VITE_ERROR_REPORTING_DSN=
