{
  "name": "@acreledger/owner-backup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Owner-only AcreLedger disaster-recovery backup worker. Not a customer-facing feature.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backup": "tsx src/backup.ts",
    "bootstrap-drive": "tsx src/bootstrapDrive.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1130.0",
    "google-auth-library": "11.0.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
